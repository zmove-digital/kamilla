{
  "name": "kamilla-store",
  "version": "1.0.0",
  "private": true,
  "description": "KAMILLA - loja de celulares em português do Brasil. SPA estática no GitHub Pages + Supabase (catálogo, variações, estoque, carrinho, checkout e painel admin), sem dependências npm. Inclui app Node/SQLite legado para uso local.",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed.js",
    "reset": "node scripts/reset.js",
    "test": "node scripts/test.js",
    "serve:static": "node scripts/serve-static.js",
    "images:static": "node scripts/generate-static-images.js",
    "supabase:seed": "node scripts/generate-supabase-seed.js",
    "demo:data": "node scripts/generate-demo-data.js",
    "mock:supabase": "node scripts/mock-supabase.js",
    "test:api": "node scripts/test-api.js",
    "test:smoke": "node scripts/smoke-static.js --demo",
    "test:smoke:live": "node scripts/smoke-static.js --live",
    "test:smoke:real": "node scripts/smoke-static.js --real"
  },
  "keywords": [
    "ecommerce",
    "supabase",
    "github-pages",
    "store",
    "node",
    "sqlite"
  ],
  "license": "MIT"
}
