# ------------------------------------------------------------------
# KAMILLA store - environment configuration
# Copy this file to ".env" and adjust the values.
# ------------------------------------------------------------------

# Server
PORT=3000
# Public base URL of the store (used for Stripe redirects + webhooks).
# In production this must be your real https domain, e.g. https://kamilla.com
BASE_URL=http://localhost:3000

# Brand
STORE_NAME=KAMILLA
STORE_TAGLINE=Luxury Hair Extensions
CURRENCY=usd

# Admin panel
# Change this before going live!
ADMIN_PASSWORD=admin123

# ---- Stripe -------------------------------------------------------
# Leave STRIPE_SECRET_KEY empty to run in LOCAL MOCK mode
# (checkout is simulated locally, no real charge - perfect for testing).
#
# To go live, paste your keys from https://dashboard.stripe.com/apikeys
# Use test keys first (sk_test_...), then switch to live keys (sk_live_...).
STRIPE_SECRET_KEY=
# Webhook signing secret from https://dashboard.stripe.com/webhooks (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Force mock mode even if keys are set (handy for local demos).
MOCK_PAYMENTS=true

# Shipping flat rate (in cents, USD). 0 = free shipping.
SHIPPING_FLAT_CENTS=0
# Free shipping threshold in cents. 0 = disabled.
FREE_SHIPPING_THRESHOLD_CENTS=15000

# Database file location
DATABASE_PATH=./data/store.db

# Seed the database on first boot if empty
SEED_ON_BOOT=true
