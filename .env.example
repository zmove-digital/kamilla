# ------------------------------------------------------------------
# KAMILLA · configuração do ambiente
# Copie este arquivo para ".env" e ajuste os valores.
# ------------------------------------------------------------------

# Servidor
PORT=3000
# URL pública da loja (usada nos redirecionamentos do Stripe + webhooks).
# Em produção use seu domínio https real, ex.: https://kamilla.com.br
BASE_URL=http://localhost:3000

# Marca
STORE_NAME=KAMILLA
STORE_TAGLINE=Smartphones & Tecnologia
CURRENCY=brl

# Painel administrativo
# Troque antes de publicar!
ADMIN_PASSWORD=admin123

# ---- Stripe -------------------------------------------------------
# Deixe STRIPE_SECRET_KEY vazio para rodar em MODO TESTE LOCAL
# (o checkout é simulado localmente, sem cobrança real — ideal para testar).
#
# Para valer de verdade, cole suas chaves de https://dashboard.stripe.com/apikeys
# Use primeiro as chaves de teste (sk_test_...), depois as de produção (sk_live_...).
STRIPE_SECRET_KEY=
# Segredo de assinatura do webhook em https://dashboard.stripe.com/webhooks (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Força o modo de teste mesmo com chaves configuradas (útil para demonstrações).
MOCK_PAYMENTS=true

# Frete fixo (em centavos, BRL). 0 = frete grátis.
SHIPPING_FLAT_CENTS=2990
# Valor mínimo para frete grátis (em centavos, BRL). 0 = desativado.
FREE_SHIPPING_THRESHOLD_CENTS=29900

# Local do banco de dados
DATABASE_PATH=./data/store.db

# Popular o banco na primeira inicialização, se estiver vazio
SEED_ON_BOOT=true
